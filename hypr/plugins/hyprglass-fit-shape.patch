+                                break;
+                            n++;
+                        }
+                        return n;
+                    };
+                    const int    topR = narrowRows(true);
+                    const int    botR = narrowRows(false);
+                    const double g    = 1.0;
+                    const double gy   = ext.y - (topR > 0 ? g : 0.0);
+                    const double gh   = ext.h + (topR > 0 ? g : 0.0) + (botR > 0 ? g : 0.0);
+                    maskInfo.glassBoxOffsetPx = Vector2D(bx1 - g - transformBox.x, gy - transformBox.y);
+                    maskInfo.glassBoxSizePx   = Vector2D(bx2 - bx1 + 2 * g, gh);
+                    const float tr = topR > 0 ? topR + g : 0.0f, br = botR > 0 ? botR + g : 0.0f;
