+            if (g_pGlobalState->config.layersFitShape && **g_pGlobalState->config.layersFitShape && !rects.empty()) {
+                const auto ext = region.getExtents();
+                auto spanAt = [&](double y, double& x1, double& x2) {
+                    bool any = false;
+                    for (const auto& r : rects) {
+                        if (r.y1 <= y && y < r.y2) {
+                            x1  = any ? std::min<double>(x1, r.x1) : r.x1;
+                            x2  = any ? std::max<double>(x2, r.x2) : r.x2;
+                            any = true;
+                        }
+                    }
+                    return any;
+                };
+                double bx1 = 0, bx2 = 0;
+                if (ext.w > 0 && ext.h > 0 && spanAt(ext.y + ext.h / 2.0, bx1, bx2)) {
+                    const int half = static_cast<int>(ext.h / 2.0);
+                    auto narrowRows = [&](bool fromTop) {
+                        int n = 0;
+                        for (int i = 0; i < half; i++) {
