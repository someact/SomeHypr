             const auto rects = region.getRects();
+
+            // layers:fit_shape: the glass is the rounded box the region outlines,
+            // not the whole layer. The box spans the region's middle row, the
+            // corner radii are the rows above/below it that are narrower, and it
+            // grows 1 px back out (clients inset the region under an anti-aliased
+            // rim, since wl_region corners are whole-pixel steps). A top band
